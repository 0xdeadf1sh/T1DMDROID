        "ref": 60.0
      },
      {
        "name": "bolus_dur_h",
        "transform": "log_ratio",
        "ref": 5.0
      },
      {
        "name": "basal_u",
        "transform": "log1p"
      },
      {
        "name": "basal_peak_min",
        "transform": "log_ratio",
        "ref": 60.0
      },
