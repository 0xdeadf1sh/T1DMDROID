<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only: lets `adb shell am broadcast` drive the sensor-free verification hooks.
             DUMP: adb shell holds it, no installed app can. Absent from release. -->
        <receiver
            android:name=".service.CgmDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.t1dm.app.INJECT_READING" />
                <action android:name="com.t1dm.app.FORCE_SIGNAL_LOSS" />
                <action android:name="com.t1dm.app.INJECT_STEPS" />
                <action android:name="com.t1dm.app.RUN_CYCLE" />
                <action android:name="com.t1dm.app.FORCE_DEGENERATE" />
                <action android:name="com.t1dm.app.FORCE_PREDICT" />
                <action android:name="com.t1dm.app.RUN_GRID_TICK" />
                <action android:name="com.t1dm.app.SEED_CONTEXT" />
                <action android:name="com.t1dm.app.WATCH_PAIR" />
                <action android:name="com.t1dm.app.WATCH_CONFIRM" />
                <action android:name="com.t1dm.app.WATCH_ROTATE" />
                <action android:name="com.t1dm.app.WATCH_UNPAIR" />
                <action android:name="com.t1dm.app.WATCH_PUSH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
