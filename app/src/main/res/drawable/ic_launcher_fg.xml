                android:fillType="evenOdd"
                android:pathData="M10.8,16 A5.2,5.2 0 1 0 21.2,16 A5.2,5.2 0 1 0 10.8,16 Z M15.1,11.6 H16.9 V20.4 H15.1 Z" />
