<?xml version="1.0" encoding="utf-8"?>
<!-- The eye from core:design's eye_paths.xml, scaled 1.5x into the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="30"
        android:translateY="30"
        android:scaleX="1.5"
        android:scaleY="1.5">
        <path
            android:strokeWidth="1.4"
            android:strokeColor="#FFFFFF"
            android:fillColor="#00000000"
            android:pathData="@string/eye_brackets" />
        <path
            android:strokeWidth="1.6"
            android:strokeColor="#FFFFFF"
            android:strokeLineJoin="miter"
            android:fillColor="#00000000"
            android:pathData="@string/eye_lid" />
        <group>
            <clip-path android:pathData="@string/eye_lid" />
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.18"
                android:pathData="@string/eye_scan" />
            <path
                android:fillColor="#FFFFFF"
                android:fillType="evenOdd"
                android:pathData="@string/eye_iris" />
        </group>
    </group>
</vector>
