<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network panel device diagnostics (issue 2): read the active transport / validated-internet
         state and the Wi-Fi signal/link. Both are normal permissions — no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- CGM: BLUETOOTH_SCAN for the brief device-discovery scan (obtain the BluetoothDevice for
         connectGatt, matched by name/serial, no location), and BLUETOOTH_CONNECT for the held GATT
         session that is the sole read path (the connected AiDEX/LinX link survives screen-off). The
         watch (Phase 5) also uses BLUETOOTH_CONNECT. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Alert polish (Phase 7B). Urgent-low/high show a full-screen intent over the lock screen and
         sound through Do-Not-Disturb; the repeat cadence is delivered by an exact alarm. The
         full-screen-intent special access must additionally be granted per-app on 14+ (Settings). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The exercise track's own type. NOT folded into CgmScanService's connectedDevice: on 34+
         startForeground throws when a declared type's permissions are missing, so a monitor that also
         claimed `location` would refuse to start for anyone who declines it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".T1dmApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.T1dm">

        <!-- Issue 12 — portrait only; landscape is not supported.
             The LAUNCHER entry is on MainActivity itself, never an <activity-alias>: a per-component
             enabled state persists in package-restrictions.xml, outranks android:enabled and survives
             an upgrade, so a retired alias can leave the package with zero launcher entries. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- connectedDevice ONLY (the CGM/watch BLE is the always-on justification). NOT dataSync:
             on Android 15+ dataSync carries a 6 h/24 h runtime cap (the service is force-stopped when
             spent, and the watchdog restart then throws) AND cannot be started from BOOT_COMPLETED —
             both fatal to a 24/7 monitor. Network sync still runs from this FGS; no type demands it. -->
        <service
            android:name=".service.CgmScanService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".service.DoseCalcService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The logged exercise bout's GPS track. Deliberately outside every auto-restart path — no
             START_STICKY, no onTaskRemoved re-arm, no watchdog, not in BootReceiver: a location
             service brought back from the background would resume recording a bout the user believes
             they ended. -->
        <service
            android:name=".service.ExerciseService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Deliberately NOT directBootAware: AppContainer opens credential-encrypted Room and touches
             external storage while constructing, so a process started in the direct-boot window would
             fail before BootReceiver ran. LOCKED_BOOT_COMPLETED is therefore never delivered here today
             and the receiver's handling of it only hands off to ACTION_USER_UNLOCKED. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Exact-alarm repeat cadence for a persisting urgent alarm (Phase 7B). App-internal. -->
        <receiver
            android:name=".notify.AlertRepeatReceiver"
            android:exported="false" />

        <!-- Snooze / Dismiss actions on the deterministic-alarm notification (§3.6 C1–C5). App-internal. -->
        <receiver
            android:name=".notify.AlarmActionReceiver"
            android:exported="false" />

        <!-- The single adaptive Glance widget (home + lock). It refreshes from the ingest cycle via
             updateAll — no Activity required.
             exported=true: HyperOS's com.miui.home renders the pin-dialog / picker preview from its own
             process, so the provider must be resolvable cross-process. APPWIDGET_UPDATE is delivered only
             by the system AppWidgetManager, so exposure is benign. -->
        <receiver
            android:name=".widget.GlucoseWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glucose_widget_info" />
        </receiver>

        <!-- Pin-confirmation success callback for WidgetPinner. App-internal. -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />
    </application>
</manifest>
