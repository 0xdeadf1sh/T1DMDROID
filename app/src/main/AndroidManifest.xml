<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- CGM: passive advertisement scan only, no location. The watch (Phase 5) additionally needs
         a CONNECTED GATT session — BLUETOOTH_CONNECT, declared by the :watch module and merged here
         (watch-link.md / build-gotchas.md). The scan permission is shared with the CGM path. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Alert polish (Phase 7B). Urgent-low/high show a full-screen intent over the lock screen and
         sound through Do-Not-Disturb; the repeat cadence is delivered by an exact alarm. The
         full-screen-intent special access must additionally be granted per-app on 14+ (Settings). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- QR token scan (Phase 7C item 12): the ZXing CaptureActivity uses the camera to read a
         server-token / {baseUrl,token} QR. Optional feature — the token can always be typed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Fallback application icon: surfaces that request the *app* icon (notably the app-logo chip
         beside the app name in every notification) use this, not a launcher alias, so without it they
         fall back to the platform default robot. Tron is the default theme. -->
    <application
        android:name=".T1dmApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_tron"
        android:roundIcon="@mipmap/ic_launcher_tron"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.T1dm">

        <!-- Issue 12 — portrait only; landscape is not supported. The launcher entry lives on the
             per-theme aliases below (issues 2/6), so MainActivity itself carries no LAUNCHER filter. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Per-theme launcher icons (issues 2/6). Exactly one alias is enabled at a time; the app
             swaps them at runtime (LauncherIconManager) when the theme changes, so the home-screen
             icon's GEOMETRY matches the active theme. Tron is the default-enabled entry. All three
             target the single MainActivity. -->
        <activity-alias
            android:name=".LauncherTron"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_tron"
            android:roundIcon="@mipmap/ic_launcher_tron"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherUmbrella"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_umbrella"
            android:roundIcon="@mipmap/ic_launcher_umbrella"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherKitty"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_kitty"
            android:roundIcon="@mipmap/ic_launcher_kitty"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.CgmScanService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />

        <service
            android:name=".service.DoseCalcService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Issue 7 — share camera-capture temp files (meal photos) with the camera app via a
             content:// Uri; also grants read to the bytes we re-open for the multipart upload. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Exact-alarm repeat cadence for a persisting urgent alarm (Phase 7B). App-internal. -->
        <receiver
            android:name=".notify.AlertRepeatReceiver"
            android:exported="false" />

        <!-- Glance widgets (Phase 7B): current-BG tile, forecast glance, compact lock glance. They
             refresh from the ingest cycle via updateAll — no Activity required. -->
        <receiver
            android:name=".widget.BgTileWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bg_tile_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PredictionGlanceWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prediction_glance_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.LockGlanceWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_glance_widget_info" />
        </receiver>
    </application>
</manifest>
