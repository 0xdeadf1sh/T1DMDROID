<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network panel device diagnostics (issue 2): read the active transport / validated-internet
         state and the Wi-Fi signal/link. Both are normal permissions — no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- CGM: passive advertisement scan only, no location. The watch (Phase 5) additionally needs
         a CONNECTED GATT session — BLUETOOTH_CONNECT, declared by the :watch module and merged here
         (watch-link.md / build-gotchas.md). The scan permission is shared with the CGM path. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Alert polish (Phase 7B). Urgent-low/high show a full-screen intent over the lock screen and
         sound through Do-Not-Disturb; the repeat cadence is delivered by an exact alarm. The
         full-screen-intent special access must additionally be granted per-app on 14+ (Settings). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Aggressive background scanning: the FGS raises AodScanActivity from a screen-off broadcast to
         hold the display genuinely ON so HyperOS/powerkeeper does not suspend the locked BLE scan. A
         background activity launch is refused on 12+ unless the app holds this permission — the
         standard "keep-alive overlay" exemption (granted once via a Settings special-access screen). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- QR token scan (Phase 7C item 12): the ZXing CaptureActivity uses the camera to read a
         server-token / {baseUrl,token} QR. Optional feature — the token can always be typed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Fallback application icon: surfaces that request the *app* icon (notably the app-logo chip
         beside the app name in every notification) use this, not a launcher alias, so without it they
         fall back to the platform default robot. Tron is the default theme. -->
    <application
        android:name=".T1dmApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_tron"
        android:roundIcon="@mipmap/ic_launcher_tron"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.T1dm">

        <!-- Issue 12 — portrait only; landscape is not supported. The launcher entry lives on the
             per-theme aliases below (issues 2/6), so MainActivity itself carries no LAUNCHER filter. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Per-theme launcher icons (issues 2/6). Exactly one alias is enabled at a time; the app
             swaps them at runtime (LauncherIconManager) when the theme changes, so the home-screen
             icon's GEOMETRY matches the active theme. Tron is the default-enabled entry. All three
             target the single MainActivity. -->
        <activity-alias
            android:name=".LauncherTron"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_tron"
            android:roundIcon="@mipmap/ic_launcher_tron"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherUmbrella"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_umbrella"
            android:roundIcon="@mipmap/ic_launcher_umbrella"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherKitty"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_kitty"
            android:roundIcon="@mipmap/ic_launcher_kitty"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherXp"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_xp"
            android:roundIcon="@mipmap/ic_launcher_xp"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherTeto"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_teto"
            android:roundIcon="@mipmap/ic_launcher_teto"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- connectedDevice ONLY (the CGM/watch BLE is the always-on justification). NOT dataSync:
             on Android 15+ dataSync carries a 6 h/24 h runtime cap (the service is force-stopped when
             spent, and the watchdog restart then throws) AND cannot be started from BOOT_COMPLETED —
             both fatal to a 24/7 monitor. Network sync still runs from this FGS; no type demands it. -->
        <service
            android:name=".service.CgmScanService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".service.DoseCalcService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The keep-screen-on "AOD" scan surface (aggressive background scanning). Its own task +
             excludeFromRecents so it never appears in Recents or the MainActivity back-stack;
             singleTask + noHistory so re-raising it never stacks; show/turn-screen-on so it can wake
             a dark display over the keyguard. app-internal (exported=false). -->
        <activity
            android:name=".aod.AodScanActivity"
            android:exported="false"
            android:theme="@style/Theme.T1dm.Aod"
            android:taskAffinity=".AodTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density" />

        <!-- Issue 7 — share camera-capture temp files (meal photos) with the camera app via a
             content:// Uri; also grants read to the bytes we re-open for the multipart upload. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Exact-alarm repeat cadence for a persisting urgent alarm (Phase 7B). App-internal. -->
        <receiver
            android:name=".notify.AlertRepeatReceiver"
            android:exported="false" />

        <!-- The single adaptive Glance widget (home + lock). It refreshes from the ingest cycle via
             updateAll — no Activity required.
             exported=true: HyperOS's com.miui.home renders the pin-dialog / picker preview from its own
             process, so the provider must be resolvable cross-process. APPWIDGET_UPDATE is delivered only
             by the system AppWidgetManager, so exposure is benign. -->
        <receiver
            android:name=".widget.GlucoseWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glucose_widget_info" />
        </receiver>

        <!-- Pin-confirmation success callback for WidgetPinner. App-internal. -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />
    </application>
</manifest>
